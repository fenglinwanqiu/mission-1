    from sklearn.metrics import confusion_matrix, classification_report
    def evaluate_model(model, loader, names, title):
        model.eval(); allp, alll = [], []
        with torch.no_grad():
            for images, labels in loader:
                out = model(images.to(device)); _, p = torch.max(out,1)
                allp.extend(p.cpu().numpy()); alll.extend(labels.numpy())
        cm = confusion_matrix(alll, allp); acc = (np.array(allp)==np.array(alll)).mean()
        plt.figure(figsize=(max(6,len(names)*0.8), max(5,len(names)*0.7)))
        sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=names, yticklabels=names)
        plt.xlabel('Predicted'); plt.ylabel('Ground Truth'); plt.title(f'{title} Confusion Matrix (Acc={acc:.4f})')
        plt.tight_layout(); plt.show()
        print(classification_report(alll, allp, target_names=names, digits=3))
    evaluate_model(model_cnn, val_loader, class_names, 'Self-built CNN')
    evaluate_model(model_resnet, val_loader, class_names, 'ResNet18')

