def predict_image(model, img_path, class_names):
    img = Image.open(img_path).convert('RGB')
    t = transforms.Compose([transforms.Resize((IMG_SIZE,IMG_SIZE)), transforms.ToTensor(),
        transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])])
    x = t(img).unsqueeze(0).to(device); model.eval()
    with torch.no_grad(): probs = torch.softmax(model(x), dim=1)[0]
    for i in range(3):
        idx = probs.topk(3).indices[i].item()
        print(f'{class_names[idx]}: {probs[idx].item()*100:.2f}%')

