def set_seed(seed=42):
    random.seed(seed); np.random.seed(seed)
    torch.manual_seed(seed); torch.cuda.manual_seed_all(seed)
set_seed(42)

device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print('使用设备:', device)

def find_image_root(base='/kaggle/input'):
    IMG_EXT = ('.jpg', '.jpeg', '.png', '.bmp')
    for dirname, subdirs, files in os.walk(base):
        if len(subdirs) >= 2:
            ok = all(len([f for f in os.listdir(os.path.join(dirname, s))
                          if f.lower().endswith(IMG_EXT)]) > 0 for s in subdirs)
            if ok:
                return dirname
    return None

DATA_DIR = find_image_root()
assert DATA_DIR, '未找到数据集，请先在右侧 Add Data 添加数据'
for s in sorted(os.listdir(DATA_DIR)):
    print(f'  {s}: {len(os.listdir(os.path.join(DATA_DIR, s)))} 张')

IMG_SIZE = 224; BATCH_SIZE = 32; EPOCHS = 20; LR = 1e-3

transform_train = transforms.Compose([
    transforms.Resize((IMG_SIZE, IMG_SIZE)),
    transforms.RandomHorizontalFlip(p=0.5),
    transforms.RandomRotation(15),
    transforms.ColorJitter(brightness=0.2, contrast=0.2, saturation=0.2),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])])
transform_val = transforms.Compose([
    transforms.Resize((IMG_SIZE, IMG_SIZE)),
    transforms.ToTensor(),
    transforms.Normalize(mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225])])

raw_dataset = datasets.ImageFolder(DATA_DIR)
class_names = raw_dataset.classes
NUM_CLASSES = len(class_names)
print('类别:', class_names, '总数:', len(raw_dataset))

train_size = int(0.8 * len(raw_dataset)); val_size = len(raw_dataset) - train_size
train_sub, val_sub = random_split(raw_dataset, [train_size, val_size])

class ApplyTransform(Dataset):
    def __init__(self, subset, transform): self.subset, self.transform = subset, transform
    def __len__(self): return len(self.subset)
    def __getitem__(self, i):
        img, label = self.subset[i]; return self.transform(img), label

train_ds = ApplyTransform(train_sub, transform_train)
val_ds   = ApplyTransform(val_sub, transform_val)
train_loader = DataLoader(train_ds, batch_size=BATCH_SIZE, shuffle=True,  num_workers=2)
val_loader   = DataLoader(val_ds,   batch_size=BATCH_SIZE, shuffle=False, num_workers=2)

class PlantCNN(nn.Module):
    """4层卷积+BN+ReLU+池化 提取特征，全局平均池化+全连接 分类"""
    def __init__(self, num_classes):
        super().__init__()
        self.features = nn.Sequential(
            nn.Conv2d(3,32,3,padding=1), nn.BatchNorm2d(32), nn.ReLU(inplace=True), nn.MaxPool2d(2),
            nn.Conv2d(32,64,3,padding=1), nn.BatchNorm2d(64), nn.ReLU(inplace=True), nn.MaxPool2d(2),
            nn.Conv2d(64,128,3,padding=1), nn.BatchNorm2d(128), nn.ReLU(inplace=True), nn.MaxPool2d(2),
            nn.Conv2d(128,256,3,padding=1), nn.BatchNorm2d(256), nn.ReLU(inplace=True), nn.MaxPool2d(2))
        self.classifier = nn.Sequential(
            nn.AdaptiveAvgPool2d(1), nn.Flatten(),
            nn.Linear(256,512), nn.ReLU(inplace=True), nn.Dropout(0.5),
            nn.Linear(512, num_classes))
    def forward(self, x): return self.classifier(self.features(x))

model_cnn = PlantCNN(NUM_CLASSES).to(device)

def make_resnet(num_classes):
    model = models.resnet18(weights=models.ResNet18_Weights.DEFAULT)
    model.fc = nn.Linear(model.fc.in_features, num_classes)
    return model
model_resnet = make_resnet(NUM_CLASSES).to(device)

def train_model(model, criterion, optimizer, scheduler, epochs):
    history = {'train_loss':[],'train_acc':[],'val_loss':[],'val_acc':[]}
    best_acc, best_state = 0.0, None
    for epoch in range(1, epochs+1):
        model.train(); trl,trc,trt = 0.0,0,0
        for images, labels in train_loader:
            images, labels = images.to(device), labels.to(device)
            optimizer.zero_grad(); outputs = model(images)
            loss = criterion(outputs, labels); loss.backward(); optimizer.step()
            trl += loss.item()*images.size(0)
            _, pred = torch.max(outputs,1); trc += (pred==labels).sum().item(); trt += labels.size(0)
        scheduler.step()
        model.eval(); val,vac,vat = 0.0,0,0
        with torch.no_grad():
            for images, labels in val_loader:
                images, labels = images.to(device), labels.to(device)
                outputs = model(images); loss = criterion(outputs, labels)
                val += loss.item()*images.size(0)
                _, pred = torch.max(outputs,1); vac += (pred==labels).sum().item(); vat += labels.size(0)
        trl/=trt; val/=vat
        history['train_loss'].append(trl); history['train_acc'].append(trc/trt)
        history['val_loss'].append(val);   history['val_acc'].append(vac/vat)
        print(f'Epoch {epoch:2d}/{epochs} | train_acc {trc/trt:.4f} | val_acc {vac/vat:.4f}')
        if vac/vat > best_acc: best_acc = vac/vat; best_state = copy.deepcopy(model.state_dict())
    model.load_state_dict(best_state)
    return model, history, best_acc

def fit(model, lr, epochs=EPOCHS):
    criterion = nn.CrossEntropyLoss()
    optimizer = optim.Adam(model.parameters(), lr=lr, weight_decay=1e-4)
    scheduler = optim.lr_scheduler.StepLR(optimizer, step_size=7, gamma=0.5)
    return train_model(model, criterion, optimizer, scheduler, epochs)

model_cnn, hist_cnn, best_cnn = fit(model_cnn, lr=1e-3)
print(f'自建CNN最佳验证准确率: {best_cnn:.4f}')

model_resnet, hist_resnet, best_resnet = fit(model_resnet, lr=1e-4)
print(f'ResNet18最佳验证准确率: {best_resnet:.4f}')

